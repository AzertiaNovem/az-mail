# AZ Mail 后端配置（systemd EnvironmentFile：/etc/azmail/azmail.env）
#
#   install -o root -g azmail -m 0640 deploy/azmail.env.example /etc/azmail/azmail.env
#
# 本文件含密钥：权限必须是 0640（root:azmail），不要提交到 Git。
# 变量名与默认值以 backend/src/config.hpp 为准；以 "# " 开头的行是保持默认值的可选项。
# 所有 CHANGE_ME_… 都是占位符，必须替换（AZMAIL_SECRET / RESEND_WEBHOOK_SECRET 的占位符会被
# 配置校验拒绝，服务无法启动）。生成并写入服务器密钥：
#   sudo sed -i "s/^AZMAIL_SECRET=.*/AZMAIL_SECRET=$(openssl rand -hex 32)/" /etc/azmail/azmail.env
# 修改后：systemctl restart azmail；检查：sudo -u azmail azmail --env-file /etc/azmail/azmail.env doctor

# =============================================================================================
# HTTP 服务
# =============================================================================================
# 只监听本机，由 Nginx（deploy/nginx-api.conf）对外提供 HTTPS。
AZMAIL_LISTEN_ADDRESS=127.0.0.1
AZMAIL_PORT=8080
# API 的公网地址（不带结尾 /），用于签名文件链接和 Me.server.files_origins。
AZMAIL_PUBLIC_API_URL=https://mail-api.example.com
# 允许跨域访问 API 的前端地址（逗号分隔，精确匹配 scheme://host[:port]；WebSocket 也按此校验 Origin）。
AZMAIL_CORS_ORIGINS=https://mail.example.com
# 只信任这些反向代理传来的 X-Forwarded-For（逗号分隔，IP 或 CIDR），用于登录限流按 IP 统计。
AZMAIL_TRUSTED_PROXIES=127.0.0.1,::1
# 同时处理的请求上限，超过返回 503。
# AZMAIL_MAX_INFLIGHT=256
# 最大并发连接数。
# AZMAIL_MAX_CONNECTIONS=4096
# 读取请求头的超时（秒）。
# AZMAIL_HEADER_TIMEOUT_SEC=15
# 读取请求体时每个数据块的空闲超时（秒，每块重新计时）。
# AZMAIL_BODY_IDLE_TIMEOUT_SEC=30
# keep-alive 连接空闲超时（秒）。
# AZMAIL_KEEPALIVE_TIMEOUT_SEC=75

# =============================================================================================
# 线程与连接池
# =============================================================================================
# 网络 IO 线程数。
# AZMAIL_IO_THREADS=2
# 普通请求（数据库）线程池。
# AZMAIL_DB_THREADS=8
# 同步调用 Resend 的线程池（取消/改定时、域名状态）。
# AZMAIL_NET_THREADS=2
# 文件读写线程池（附件上传下载、R2 代理）。
# AZMAIL_FILES_THREADS=8
# SQLite 连接数：应 ≥ db + net + files + 所有任务线程（默认 8+2+8+6=24）。
# AZMAIL_DB_POOL_SIZE=24
# 后台任务线程：发信 / 收信 / 同步 / 维护。
# AZMAIL_JOBS_OUTBOUND_THREADS=2
# AZMAIL_JOBS_INBOUND_THREADS=2
# AZMAIL_JOBS_SYNC_THREADS=1
# AZMAIL_JOBS_MAINTENANCE_THREADS=1
# 优雅停机的总时限（秒）：关闭连接 + 等待正在运行的后台任务都在这个时间内完成。
# deploy/azmail.service 的 TimeoutStopSec=40 必须比它至少大 10 秒；调大此值时同步调大 TimeoutStopSec。
# AZMAIL_SHUTDOWN_GRACE_SEC=25

# =============================================================================================
# 存储
# =============================================================================================
# 这两行必须保留并使用绝对路径：程序内置的默认值是相对路径 data 和 data/azmail.db，按“当前目录”
# 解析——服务的当前目录是 /var/lib/azmail，而 `sudo -u azmail azmail …` 命令行工具沿用执行者的
# 当前目录，会操作另一个（空的）数据库。
# 数据目录：blobs/（本地存储时）、tmp/、cache/（R2 代理缓存）。
AZMAIL_DATA_DIR=/var/lib/azmail
# SQLite 数据库，必须在本地磁盘上（不要放 NFS）。
AZMAIL_DB_PATH=/var/lib/azmail/azmail.db

# =============================================================================================
# 安全
# =============================================================================================
# 服务器密钥（附件 / 原始邮件签名链接的唯一密钥），至少 32 字节随机数：openssl rand -hex 32
# 必须替换：知道这个值的人可以伪造任何用户的附件和原始邮件下载链接。下面的占位符会被配置校验拒绝。
# 更换后所有已发出的附件链接立即失效。
AZMAIL_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# 会话有效期（天，滑动续期）。
# AZMAIL_SESSION_TTL_DAYS=30
# 会话最近活动时间最多多久写一次库（秒）。
# AZMAIL_SESSION_TOUCH_SEC=3600
# 登录失败限流：同一邮箱 / 同一 IP 在窗口内的最大失败次数，窗口长度（秒）。
# AZMAIL_LOGIN_MAX_PER_EMAIL=5
# AZMAIL_LOGIN_MAX_PER_IP=20
# AZMAIL_LOGIN_WINDOW_SEC=900
# 同时进行的 scrypt 密码计算数（防 CPU 耗尽）。
# AZMAIL_SCRYPT_CONCURRENCY=4
# 附件 / 原始邮件签名链接有效期（秒）。
# AZMAIL_SIGNED_URL_TTL_SEC=43200

# =============================================================================================
# 邮件
# =============================================================================================
# 团队域名（逗号分隔）。运行时以数据库 domains 表为准（azmail add-domain）。
AZMAIL_LOCAL_DOMAINS=example.com
# 新用户默认“撤销发送”时间（秒）：0 / 5 / 10 / 20 / 30。
# AZMAIL_UNDO_SEND_SECONDS=5
# 定时发送方式：resend（无附件时交给 Resend 定时）或 local（总是由本服务定时）。
# AZMAIL_SCHEDULE_MODE=resend
# 定时发送允许的最早时间（现在 + 秒）与最晚时间（天）。
# AZMAIL_SCHEDULE_MIN_LEAD_SEC=60
# AZMAIL_SCHEDULE_MAX_DAYS=30
# 收件人 / 抄送 / 密送各自的人数上限。
# AZMAIL_MAX_RECIPIENTS=50
# 发往本域但不存在的地址：1 = 投递给管理员；0 = 只在管理后台“无法投递”中显示。
# AZMAIL_UNROUTABLE_TO_ADMINS=0

# =============================================================================================
# 大小限制（字节）
# =============================================================================================
# AZMAIL_MAX_HEADER_BYTES=16384
# AZMAIL_JSON_BODY_LIMIT=1048576
# 草稿（含内嵌 HTML）请求体上限。
# AZMAIL_DRAFT_BODY_LIMIT=8388608
# 单个附件上限（25 MiB）。Nginx client_max_body_size 30m 要比它大。
# AZMAIL_UPLOAD_LIMIT=26214400
# AZMAIL_WEBHOOK_BODY_LIMIT=1048576
# 每封邮件附件原始大小合计上限（28 MiB；base64 后加正文仍低于 Resend 的 40 MB）。
# AZMAIL_MAX_MESSAGE_ATTACHMENTS=29360128
# 收信时单个附件 / 原始邮件的下载上限。
# AZMAIL_INBOUND_ATTACHMENT_LIMIT=52428800
# AZMAIL_INBOUND_RAW_LIMIT=62914560

# =============================================================================================
# 保留期与维护
# =============================================================================================
# 已删除邮件 / 垃圾邮件保留天数，到期永久删除。
# AZMAIL_TRASH_PURGE_DAYS=30
# AZMAIL_SPAM_PURGE_DAYS=30
# 上传后未使用的附件保留（小时）。
# AZMAIL_UPLOAD_TTL_HOURS=24
# 无引用的文件（blob）多久后回收（小时）。
# AZMAIL_BLOB_GC_GRACE_HOURS=24
# 已完成后台任务 / webhook 事件记录保留天数。
# AZMAIL_JOBS_RETENTION_DAYS=7
# AZMAIL_WEBHOOK_RETENTION_DAYS=30
# 轮询 Resend 收件列表的间隔（秒；webhook 不可达时靠它收信）。
# AZMAIL_POLL_INTERVAL_SEC=120
# 对账未完成发信状态的间隔（秒）。
# AZMAIL_RECONCILE_INTERVAL_SEC=600

# =============================================================================================
# Resend
# =============================================================================================
# Full access 权限的 API Key（re_…；收信接口需要；建议本服务独占一个 Key，因为 10 次/秒限额按团队共享）。
RESEND_API_KEY=CHANGE_ME_resend_full_access_api_key
# API 地址（只在测试时改为模拟服务器）。
# RESEND_API_BASE=https://api.resend.com
# Webhook 签名密钥 whsec_…（Resend 控制台 → Webhooks → 该端点的 Signing secret，原样复制）。
# 必须替换：知道这个值的人可以伪造 webhook。下面的占位符不以 whsec_ 开头，会被配置校验拒绝。
RESEND_WEBHOOK_SECRET=CHANGE_ME_resend_webhook_signing_secret
# 请求 Resend 时的 User-Agent（缺失会被 Cloudflare 拒绝：403 error code: 1010）。
# RESEND_USER_AGENT=azmail/0.1.0
# 本服务对 Resend 的请求速率（次/秒，团队上限 10，与其他应用共享）。
# RESEND_RATE_RPS=8
# 调用 Resend 的超时（秒）。
# RESEND_TIMEOUT_SEC=30
# Webhook 时间戳允许的误差（秒）。服务器必须开启 NTP 时间同步。
# AZMAIL_WEBHOOK_TOLERANCE_SEC=300

# =============================================================================================
# 出站 HTTP 客户端
# =============================================================================================
# 仅测试用：允许 http:// 地址（模拟服务器）。生产环境保持 0。
# AZMAIL_ALLOW_INSECURE_HTTP=0
# 自定义 CA 证书文件（留空 = 系统默认信任库）。
# AZMAIL_CA_FILE=

# =============================================================================================
# 文件存储：Cloudflare R2（推荐）或本地磁盘
# =============================================================================================
# r2 = 附件和原始邮件存到 R2；local = 存到 $AZMAIL_DATA_DIR/blobs。
AZMAIL_BLOB_BACKEND=r2
# R2 账户 ID（32 位十六进制；Cloudflare 控制台 → R2 → 右侧 Account ID）。
R2_ACCOUNT_ID=CHANGE_ME_r2_account_id
# R2 API 令牌（权限 Object Read & Write，仅限本存储桶）的 Access Key ID / Secret（只显示一次）。
R2_ACCESS_KEY_ID=CHANGE_ME_r2_access_key_id
R2_SECRET_ACCESS_KEY=CHANGE_ME_r2_secret_access_key
# 存储桶名称。
R2_BUCKET=azmail
# S3 API 地址；留空 = https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com。
# 欧盟管辖区存储桶：https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=
# 对象键前缀（键为 <前缀>blobs/aa/bb/<sha256>）。
# R2_PREFIX=azmail/
# 浏览器如何下载附件：
#   proxy    = 后端从 R2 取回并经 API 域名转发（默认；中国大陆访问 *.r2.cloudflarestorage.com 常常很慢）
#   redirect = 302 跳转到 R2 预签名链接（节省服务器流量；先用 azmail doctor --r2 验证）
# AZMAIL_FILES_DELIVERY=proxy
# redirect 模式下预签名链接有效期（秒）。
# R2_PRESIGN_TTL_SEC=300
# proxy 模式本地缓存上限（MB，位于 $AZMAIL_DATA_DIR/cache）。
# AZMAIL_FILE_CACHE_MB=1024

# =============================================================================================
# 日志
# =============================================================================================
# trace | debug | info | warn | error（输出到 stderr → journald；不记录密钥、令牌和邮件正文）。
AZMAIL_LOG_LEVEL=info

# =============================================================================================
# WebSocket
# =============================================================================================
# 连接后必须在多少毫秒内完成认证。
# AZMAIL_WS_AUTH_TIMEOUT_MS=5000
# 客户端单条消息上限（字节）。
# AZMAIL_WS_MAX_MESSAGE_BYTES=16384
# 每个连接待发送消息队列上限（溢出则断开，客户端会自动重连并刷新）。
# AZMAIL_WS_QUEUE_CAP=512
# 每个用户最多同时连接数（超出时关闭最旧的连接）。
# AZMAIL_WS_MAX_PER_USER=32
